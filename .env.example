# 一键部署环境变量示例：cp .env.example .env
# .env 已被 .gitignore 忽略；以下默认值仅供本地演示，部署到公网前必须全部替换。
# 未创建 .env 时 compose 使用内置默认值，应用仍可启动（AI / 支付能力不可用）。

# ---- 端口 ----
WEB_PORT=8082
APP_PORT=8081

# ---- PostgreSQL ----
PG_PASSWORD=change_me_local

# ---- 认证 / 注册 ----
CORS_ORIGINS=http://localhost:8082,http://127.0.0.1:8082
# 本地固定验证码（application.yml 默认 123456），生产必须关闭。
DEV_VERIFY_CODE_ENABLED=true
# 演示账号：留空则不创建。
DEMO_ENABLED=false
DEMO_EMAIL=demo@offercoach.dev
DEMO_PASSWORD=

# ---- 管理端（可选）----
ADMIN_ENABLED=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# ---- AI（可选；未启用时走启发式降级）----
AI_ENABLED=false
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
# 管理端保存 API Key 的 AES-GCM 根密钥；留空则只能改 URL / 模型。
OC_AI_SECRET=

# ---- 服务间内部令牌（启用 AI 工具 / 支付服务时必须与对方一致）----
OC_AI_INTERNAL_TOKEN=change_me_local
OC_PAY_INTERNAL_TOKEN=change_me_local

# ---- 可信代理（可选）----
# 前端 Nginx 会把它作为 X-Proxy-Secret 发给 oc-app，oc-app 据此采信 X-Real-IP。
# 留空时应用忽略全部代理头、按 Nginx 容器 IP 识别客户端 —— 本地演示可用，
# 但所有用户会共用同一个限流桶；多用户演示或多实例请填写并保持前后端一致。
AUTH_PROXY_SECRET=

# ---- 运维参数（可选，括号内为默认值）----
# 定时任务线程池大小（4）；日志保留天数（AI 调用 90 / 审计 1095 / 支付回调 180）
# SCHEDULING_POOL_SIZE=4
# RETENTION_AI_CALL_DAYS=90
# RETENTION_AUDIT_DAYS=1095
# RETENTION_PAYMENT_NOTIFY_DAYS=180
# 订阅与额度周期到期结算（每天 03:10 北京时间）
# SUBSCRIPTION_EXPIRY_CRON=0 10 3 * * *
# Prometheus 抓取鉴权（留空则不校验）
# METRICS_TOKEN=
