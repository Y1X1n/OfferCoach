server {
    # 非 root 不能监听 <1024 的特权端口；宿主机端口由 compose 映射。
    listen 8080;
    server_name _;

    root /usr/share/nginx/html;
    index index.html;

    gzip on;
    gzip_comp_level 5;
    gzip_min_length 1024;
    # 中文体量最大的是字体：构建产物里是 WOFF2（本身已压缩），不需要 gzip。
    # gzip_vary 必开：响应是否压缩取决于 Accept-Encoding，共享缓存必须据此分桶，
    # 否则可能把 gzip 响应发给不支持压缩的客户端。
    gzip_vary on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain;

    include snippets/security-headers.conf;

    location /assets/ {
        expires 30d;
        # 不加 always：`try_files ... =404` 的 404 响应也会带上这条头，滚动发布期间
        # 旧 index.html 引用的 chunk 会 404，而 404 被缓存成 immutable 就等于永久白屏。
        add_header Cache-Control "public, immutable";
        # 本 location 有自己的 add_header，server 级的对它全部失效，必须重复引入。
        include snippets/security-headers.conf;
        try_files $uri =404;
    }

    # 入口 HTML 必须每次回源校验：文件名不带内容哈希，强缓存会让升级后的用户继续引用已被
    # 删除的旧 assets（表现为白屏或 404）。no-cache 仍可用 ETag 304，不会重复下载正文。
    location = /index.html {
        add_header Cache-Control "no-cache" always;
        include snippets/security-headers.conf;
    }

    # 容器内把 /api 反代到 oc-app（compose 服务名）。
    # 变量形式让 nginx 启动时不依赖上游 DNS；宿主机 Nginx 若已处理 /api，不会走到这里。
    resolver 127.0.0.11 valid=10s ipv6=off;
    set $oc_app_upstream http://oc-app:8081;

    location /api/ {
        proxy_pass $oc_app_upstream;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header Connection "";
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # 可信代理密钥：由 compose 的 AUTH_PROXY_SECRET 注入。官方镜像的 envsubst 用
        # NGINX_ENVSUBST_FILTER 限定只替换这一个变量，因此上面的 $host / $remote_addr
        # 等 nginx 变量保持原样。留空时头为空值，oc-app 会忽略全部代理头并按本容器 IP 识别客户端。
        proxy_set_header X-Proxy-Secret "${AUTH_PROXY_SECRET}";
        # 反馈轮询与 SSE 兼容：关闭缓冲并放宽超时。
        proxy_buffering off;
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
        client_max_body_size 12m;
    }

    location / {
        try_files $uri $uri/ /index.html;
    }
}
