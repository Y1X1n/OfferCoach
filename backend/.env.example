# 本地开发环境变量示例：cp .env.example .env
# .env 已被 .gitignore 忽略；Compose 自动读取，scripts/run-dev.sh 启动前会 source 它。
# 未配置时应用使用 application.yml 中的 dev 默认值。

# ---- Compose ----
PG_PASSWORD=change_me_local
MQ_PASSWORD=change_me_local

# ---- 演示账号（仅本地；留空则跳过初始化）----
DEMO_ENABLED=false
DEMO_EMAIL=demo@offercoach.dev
DEMO_PASSWORD=

# ---- JWT（RS256 PEM 文件绝对路径；留空则使用开发用临时密钥，仅限 local）----
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ---- 认证 / CORS ----
COOKIE_SECURE=false
DEV_VERIFY_CODE_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- 数据库 ----
DB_URL=jdbc:postgresql://localhost:5432/offercoach
DB_USER=oc
DB_PASSWORD=change_me_local

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379

# ---- 支付服务 oc-pay（内部令牌 oc-app 与 oc-pay 必须一致）----
OC_PAY_INTERNAL_TOKEN=
OC_PAY_BASE_URL=http://127.0.0.1:8099
OC_PAY_APP_BASE_URL=http://127.0.0.1:8081
# 渠道回调对外基地址；本地联调留空即可（仅模拟渠道可用）。
OC_PAY_PUBLIC_BASE_URL=
# 本地模拟支付渠道；生产开启会在启动时直接失败。
OC_PAY_MOCK_ENABLED=true

# 微信支付 v3 / 支付宝：仅在服务器端 600 权限文件中配置，切勿提交仓库。
# OC_PAY_WECHAT_ENABLED=false
# WECHAT_PAY_APP_ID=
# WECHAT_PAY_MCH_ID=
# WECHAT_PAY_MCH_SERIAL_NO=
# WECHAT_PAY_PRIVATE_KEY_PATH=
# WECHAT_PAY_API_V3_KEY=
# WECHAT_PAY_PLATFORM_CERT_PATH=
# OC_PAY_ALIPAY_ENABLED=false
# ALIPAY_APP_ID=
# ALIPAY_PRIVATE_KEY_PATH=
# ALIPAY_PUBLIC_KEY_PATH=