# 本地开发环境变量示例：cp .env.example .env
# .env 已被 .gitignore 忽略；Compose 自动读取，scripts/run-dev.sh 启动前会 source 它。
# 未配置时应用使用 application.yml 中的 dev 默认值。

# ---- Compose ----
PG_PASSWORD=change_me_local
MQ_PASSWORD=change_me_local

# ---- 演示账号（仅本地；留空则跳过初始化）----
DEMO_ENABLED=false
DEMO_EMAIL=demo@offercoach.dev
DEMO_PASSWORD=

# ---- JWT（RS256 PEM 文件绝对路径；留空则使用开发用临时密钥，仅限 local）----
JWT_PRIVATE_KEY_PATH=
JWT_PUBLIC_KEY_PATH=

# ---- 认证 / CORS ----
COOKIE_SECURE=false
DEV_VERIFY_CODE_ENABLED=true
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# ---- 数据库 ----
DB_URL=jdbc:postgresql://localhost:5432/offercoach
DB_USER=oc
DB_PASSWORD=change_me_local

# ---- Redis ----
REDIS_HOST=localhost
REDIS_PORT=6379