<view class="container">
  <view a:if="{{loading}}" class="empty">加载中…</view>

  <block a:if="{{!loading && resume}}">
    <view class="head">
      <view class="row-between">
        <view class="head-title detail-title">{{resume.title}}</view>
        <text class="badge badge-ok" a:if="{{resume.isDefault}}">默认</text>
      </view>
      <view class="muted small">
        {{statusText}} · {{resume.sourceType === 'MANUAL' ? '手动录入' : '文件解析'}} · {{dateText}}
      </view>
    </view>

    <view class="card" a:if="{{resume.parseStatus !== 'READY'}}">
      <view class="card-title">{{statusText}}</view>
      <view class="tiny muted">{{resume.parseError || '解析在后台进行，通常 5-20 秒；完成后可查看结构化内容。'}}</view>
      <button class="btn next" onTap="refresh" disabled="{{refreshing}}">
        {{refreshing ? '刷新中…' : '刷新状态'}}
      </button>
    </view>

    <view class="card" a:if="{{resume.summary}}">
      <view class="card-title">摘要</view>
      <view class="small">{{resume.summary}}</view>
    </view>

    <view class="card" a:if="{{sections.length}}">
      <view class="card-title">结构化内容</view>
      <view class="section" a:for="{{sections}}" a:key="title">
        <view class="section-name">{{item.title}}</view>
        <view class="section-line" a:for="{{item.items}}" a:for-item="line" a:key="*this">{{line}}</view>
      </view>
      <view class="tiny muted" a:if="{{lowConfidence.length}}">
        待确认字段：{{lowConfidenceText}}
      </view>
    </view>

    <view class="grid-2">
      <view class="tile" onTap="rename">
        <view class="tile-title">重命名</view>
        <view class="tile-sub">只改标题，不影响内容</view>
      </view>
      <view class="tile" onTap="setDefault">
        <view class="tile-title">设为默认</view>
        <view class="tile-sub">创建面试时优先选中</view>
      </view>
      <view class="tile" onTap="reparse">
        <view class="tile-title">重新解析</view>
        <view class="tile-sub">每小时最多 2 次，不扣额度</view>
      </view>
      <view class="tile" onTap="exportMarkdown">
        <view class="tile-title">导出 Markdown</view>
        <view class="tile-sub">复制到剪贴板</view>
      </view>
      <view class="tile" onTap="exportJson">
        <view class="tile-title">导出 JSON</view>
        <view class="tile-sub">结构化原始数据</view>
      </view>
      <view class="tile" onTap="download" a:if="{{resume.sourceType !== 'MANUAL'}}">
        <view class="tile-title">下载原文件</view>
        <view class="tile-sub">打开原始 PDF / Word</view>
      </view>
    </view>

    <button class="btn btn-ghost" onTap="remove">删除这份简历</button>
    <view class="safe-bottom"></view>
  </block>
</view>
