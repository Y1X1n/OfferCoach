<view class="container">
  <view class="hero">
    <view class="row-between">
      <view class="hero-kicker">OFFERCOACH · 面试教练</view>
      <view class="plan-pill" data-url="/pages/me/me" onTap="go">{{planLabel}}</view>
    </view>
    <view class="hero-title">把简历和目标岗位交给它，练一场真面试</view>
    <view class="hero-sub">按你的经历出题，答完立刻拿到证据与改写建议。</view>
  </view>

  <view class="quota" a:if="{{quota}}">
    <view class="quota-main">
      <text class="quota-num">{{quota.daily.sessionsLimit - quota.daily.sessionsUsed}}</text>
      <text class="quota-unit">场今日可练</text>
    </view>
    <view class="quota-side">
      <text class="tiny muted">面试额度 {{quota.interviewCredits}} · 解析额度 {{quota.resumeCredits}}</text>
      <text class="tiny muted">额度周期至 {{quota.periodEnd}}</text>
    </view>
  </view>

  <view class="card active" a:if="{{active}}">
    <view class="row-between">
      <text class="card-title">进行中的面试</text>
      <text class="tiny badge badge-ember">{{active.statusLabel}}</text>
    </view>
    <view class="active-title">{{active.jdTitle || '模拟面试'}}</view>
    <view class="tiny muted">
      {{active.resumeTitle || '简历'}} · 已答 {{active.answeredCount}}/{{active.questionCount}} 题 · {{active.timeText}}
    </view>
    <button class="btn next" onTap="continueSession">继续这场面试</button>
  </view>

  <button class="btn" onTap="startInterview">
    {{demoBusy ? demoPhase : '开始一次模拟面试'}}
  </button>
  <button class="btn btn-ghost next" onTap="quickDemo" disabled="{{demoBusy}}">
    {{demoBusy ? demoPhase : '没准备简历？用示例直接体验'}}
  </button>
  <view class="tiny muted hint-center">示例使用虚构简历与「高级后端工程师」岗位，约 1 分钟走完一场。</view>

  <view class="grid-2 quick">
    <view class="tile" data-url="/pages/resume/list" onTap="go">
      <view class="tile-title">我的简历</view>
      <view class="tile-sub">{{resumeReady ? '已有可用简历' : '上传或粘贴一份'}}</view>
    </view>
    <view class="tile" data-url="/pages/jd/list" onTap="go">
      <view class="tile-title">目标岗位</view>
      <view class="tile-sub">{{jdCount}} 个 JD · 支持链接与搜索</view>
    </view>
    <view class="tile" data-url="/pages/reports/reports" onTap="go">
      <view class="tile-title">复盘报告</view>
      <view class="tile-sub">共 {{reportTotal}} 份{{avgText}}</view>
    </view>
    <view class="tile" data-url="/pages/plans/plans" onTap="go">
      <view class="tile-title">套餐与额度</view>
      <view class="tile-sub">升级后可练更多场</view>
    </view>
  </view>

  <view class="card" a:if="{{reports.length}}">
    <view class="row-between">
      <text class="card-title">最近报告</text>
      <text class="tiny link" data-url="/pages/reports/reports" onTap="go">全部</text>
    </view>
    <view class="list-item" a:for="{{reports}}" a:key="id" data-id="{{item.id}}" onTap="openReport">
      <view class="list-main">
        <view class="list-title">{{item.title}}</view>
        <view class="list-sub">{{item.role}} · {{item.dateText}}</view>
      </view>
      <text class="score">{{item.overallScore}}</text>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="empty" a:if="{{!loading && !reports.length}}">还没有报告，先练一场。</view>

  <view class="notice">
    <view class="notice-title">关于这份练习</view>
    <view class="tiny muted">评分只用于练习参考，不代表任何企业的真实录用结论。简历仅用于本次练习的结构化与出题，可随时删除；我们不会将其用于训练或对外提供。</view>
  </view>

  <view class="safe-bottom"></view>
</view>
