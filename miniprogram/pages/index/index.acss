.hero {
  padding: 24rpx 8rpx 32rpx;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 4rpx;
  color: #a34a2a;
  font-weight: 600;
}

.hero-title {
  margin-top: 16rpx;
  font-size: 46rpx;
  line-height: 1.35;
  font-weight: 700;
  color: #0f172a;
}

.hero-sub {
  margin-top: 16rpx;
  font-size: 26rpx;
  color: #5b6472;
}

.quota {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #0f172a;
  border-radius: 24rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}

.quota-main {
  display: flex;
  align-items: baseline;
}

.quota-num {
  font-size: 52rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.quota-unit {
  margin-left: 10rpx;
  font-size: 24rpx;
  color: #c7cdd6;
}

.quota-side {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
}

.quota-side .muted {
  color: #9aa3af;
}

.steps {
  padding: 8rpx 32rpx;
}

.step {
  display: flex;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.step:last-child {
  border-bottom: none;
}

.step-index {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fdf0ea;
  color: #a34a2a;
  font-size: 24rpx;
  font-weight: 600;
  text-align: center;
  line-height: 44rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
}

.step-title {
  font-size: 28rpx;
  font-weight: 600;
}

.step-desc {
  margin-top: 4rpx;
}

.recent {
  margin-top: 24rpx;
}

.session {
  display: flex;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.session:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.session-main {
  flex: 1;
  min-width: 0;
}

.session-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.session-score {
  font-size: 34rpx;
  font-weight: 700;
  color: #a34a2a;
  margin-left: 16rpx;
}

.session-arrow {
  color: #c3c9d2;
  font-size: 36rpx;
  margin-left: 12rpx;
}

.notice {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #eef1f5;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 8rpx;
}

.plan-pill {
  font-size: 22rpx;
  color: #a34a2a;
  background: #fdf0ea;
  border-radius: 999rpx;
  padding: 6rpx 18rpx;
}

.active {
  border: 2rpx solid #0f172a;
}

.active-title {
  font-size: 30rpx;
  font-weight: 600;
  margin: 12rpx 0 6rpx;
}

.next {
  margin-top: 20rpx;
}

.quick {
  margin-top: 24rpx;
}

.quick .tile {
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.score {
  font-size: 32rpx;
  font-weight: 700;
  color: #a34a2a;
  margin-left: 12rpx;
}
