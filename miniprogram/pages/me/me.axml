<view class="container">
  <view class="head">
    <view class="head-title">我的</view>
    <view class="muted small">{{me.email || '体验账号'}}</view>
  </view>

  <view class="quota" a:if="{{quota}}">
    <view class="quota-main">
      <text class="quota-num">{{quota.interviewCredits}}</text>
      <text class="quota-unit">次面试额度</text>
    </view>
    <view class="quota-side">
      <text class="tiny muted">{{quota.planName}} · 今日 {{quota.daily.sessionsUsed}}/{{quota.daily.sessionsLimit}}</text>
      <text class="tiny muted">周期至 {{quota.periodEnd}}</text>
    </view>
  </view>

  <view class="list">
    <view class="list-item" onTap="editNickname">
      <view class="list-main">
        <view class="list-title">昵称</view>
        <view class="list-sub">{{me.nickname || '体验用户'}}</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-item" data-url="/pages/plans/plans" onTap="go">
      <view class="list-main">
        <view class="list-title">套餐与额度</view>
        <view class="list-sub">{{quota.planName}} · 升级后可用更多场</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-item" data-url="/pages/reports/reports" onTap="go">
      <view class="list-main">
        <view class="list-title">我的报告</view>
        <view class="list-sub">查看历史分数与逐题拆解</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="card" a:if="{{invite}}">
    <view class="card-title">邀请好友</view>
    <view class="invite-code">{{invite.inviteCode || '—'}}</view>
    <view class="tiny muted">
      已邀请 {{invite.invitedCount}} 人 · 累计获得 {{invite.rewardedInterviewCredits}} 次面试额度
    </view>
    <view class="tiny muted" a:if="{{invite.inviteCode}}">
      注册时填写邀请码，双方各得奖励（今日剩余 {{invite.remainingToday}} 个名额）
    </view>
    <button class="btn btn-ghost next" a:if="{{invite.inviteCode}}" onTap="copyInvite">复制邀请码</button>
  </view>

  <view class="list">
    <view class="list-item" onTap="exportData">
      <view class="list-main">
        <view class="list-title">导出我的数据</view>
        <view class="list-sub">简历、会话与报告的 JSON 快照</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-item" onTap="logout">
      <view class="list-main">
        <view class="list-title">退出登录</view>
        <view class="list-sub">下次进入会重新创建体验账号</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
    <view class="list-item" onTap="deleteAccount">
      <view class="list-main">
        <view class="list-title danger-text">注销账号</view>
        <view class="list-sub">7 天后物理删除，不可恢复</view>
      </view>
      <text class="list-arrow">›</text>
    </view>
  </view>

  <view class="notice">
    <view class="notice-title">隐私与边界</view>
    <view class="tiny muted">简历只用于本次结构化与出题；评分仅用于练习参考，不代表任何企业的真实录用结论。</view>
  </view>

  <view class="safe-bottom"></view>
</view>
