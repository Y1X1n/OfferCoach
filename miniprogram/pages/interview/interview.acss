.progress {
  padding: 8rpx 8rpx 24rpx;
}

.progress-meta {
  display: flex;
  justify-content: space-between;
  margin-bottom: 12rpx;
}

.question {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.question-text {
  margin-top: 20rpx;
  font-size: 34rpx;
  line-height: 1.6;
  font-weight: 600;
}

.why {
  margin-top: 20rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}

.why-label {
  display: block;
  font-size: 22rpx;
  color: #a34a2a;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.why-text {
  font-size: 24rpx;
  color: #5b6472;
}

.answer {
  height: 320rpx;
  margin-top: 16rpx;
}

.gap {
  margin-top: 24rpx;
}

.grow {
  flex: 1;
  margin-left: 16rpx;
}

.score {
  font-size: 48rpx;
  font-weight: 700;
  color: #a34a2a;
  line-height: 1;
}

.degraded {
  margin-top: 12rpx;
  padding: 12rpx 16rpx;
  background: #fff7ed;
  border-radius: 12rpx;
  color: #9a3412;
}

.dim {
  margin-top: 20rpx;
}

.dim-head {
  margin-bottom: 8rpx;
}

.block {
  margin-top: 28rpx;
}

.block-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 12rpx;
}

.block-item {
  display: flex;
  margin-bottom: 8rpx;
}

.dot {
  margin-right: 10rpx;
  font-weight: 700;
}

.dot-ok {
  color: #2f7f5b;
}

.dot-warn {
  color: #b45309;
}

.block-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2937;
}

.evidence {
  background: #f7f8fa;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  margin-bottom: 12rpx;
}

.evidence-quote {
  font-size: 26rpx;
  color: #0f172a;
  margin-bottom: 6rpx;
}

.rewrite {
  background: #fdf0ea;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 26rpx;
  line-height: 1.7;
  color: #7c2d12;
}

.next {
  margin-top: 32rpx;
}

.footnote {
  text-align: center;
  margin-top: 8rpx;
}

.done {
  text-align: center;
  padding: 48rpx 32rpx;
}

.done-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}
