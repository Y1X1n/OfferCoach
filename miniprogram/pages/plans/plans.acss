.plan-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.plan-current {
  border: 2rpx solid #0f172a;
}

.plan-name {
  font-size: 32rpx;
  font-weight: 700;
}

.plan-price {
  text-align: right;
}

.plan-amount {
  font-size: 34rpx;
  font-weight: 700;
  color: #a34a2a;
}

.plan-credits {
  font-size: 24rpx;
  color: #475569;
  margin-top: 12rpx;
}
