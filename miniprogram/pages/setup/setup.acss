.head {
  padding: 8rpx 8rpx 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.textarea {
  height: 300rpx;
  margin-top: 16rpx;
}

.jd-input {
  height: 240rpx;
}

.meta {
  margin-top: 12rpx;
}

.chips {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.chip {
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  border: 2rpx solid #e5e9ef;
  background: #f7f8fa;
  font-size: 24rpx;
  color: #475569;
  margin: 0 16rpx 16rpx 0;
}

.chip-on {
  border-color: #0f172a;
  background: #0f172a;
  color: #ffffff;
}

.opt-label {
  font-size: 24rpx;
  color: #6b7280;
  margin: 24rpx 0 12rpx;
}

.seg {
  display: flex;
  background: #f5f6f8;
  border-radius: 16rpx;
  padding: 6rpx;
}

.seg-item {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 24rpx;
  color: #5b6472;
  border-radius: 12rpx;
}

.seg-on {
  background: #ffffff;
  color: #0f172a;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(15, 23, 42, 0.08);
}

.hint {
  margin-top: 20rpx;
  text-align: center;
}

.pick {
  margin-top: 12rpx;
  padding: 20rpx 24rpx;
  background: #f7f8fa;
  border-radius: 16rpx;
}

.pick-title {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 6rpx;
}
