<view class="container">
  <view class="head">
    <view class="head-title">准备这场面试</view>
    <view class="muted small">简历决定「问你什么」，岗位决定「标准是什么」。</view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">你的简历</text>
      <text class="tiny muted" data-field="resume" onTap="fillSample">填入示例</text>
    </view>
    <textarea
      class="field textarea"
      value="{{resumeText}}"
      placeholder="把简历文本粘贴进来：教育背景、工作经历、项目、技能。"
      placeholder-class="placeholder"
      maxlength="{{50000}}"
      onInput="onResumeInput"
    />
    <view class="row-between meta">
      <text class="tiny muted">至少 20 字，建议包含项目背景与量化结果</text>
      <text class="tiny muted">{{resumeText.length}} 字</text>
    </view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">目标岗位</text>
      <text class="tiny muted" data-field="jd" onTap="fillSample">填入示例</text>
    </view>
    <view class="chips">
      <view
        class="chip {{job.id === activeJob ? 'chip-on' : ''}}"
        a:for="{{jobs}}"
        a:key="id"
        data-id="{{item.id}}"
        onTap="pickJob"
      >
        {{item.name}}
      </view>
    </view>
    <textarea
      class="field textarea jd-input"
      value="{{jdText}}"
      placeholder="粘贴招聘 JD 原文；也可以先点上方岗位一键填入示例。"
      placeholder-class="placeholder"
      maxlength="{{8000}}"
      onInput="onJdInput"
    />
    <view class="row-between meta">
      <text class="tiny muted">至少 50 字</text>
      <text class="tiny muted">{{jdText.length}} 字</text>
    </view>
  </view>

  <view class="card">
    <view class="card-title">这场怎么练</view>
    <view class="opt-label">题量</view>
    <view class="seg">
      <view class="seg-item {{questionCount === 3 ? 'seg-on' : ''}}" data-count="3" onTap="pickCount">3 题 · 快速</view>
      <view class="seg-item {{questionCount === 5 ? 'seg-on' : ''}}" data-count="5" onTap="pickCount">5 题 · 标准</view>
      <view class="seg-item {{questionCount === 8 ? 'seg-on' : ''}}" data-count="8" onTap="pickCount">8 题 · 完整</view>
    </view>
    <view class="opt-label">难度</view>
    <view class="seg">
      <view class="seg-item {{difficulty === 'MIXED' ? 'seg-on' : ''}}" data-value="MIXED" onTap="pickDifficulty">循序渐进</view>
      <view class="seg-item {{difficulty === 'HARD' ? 'seg-on' : ''}}" data-value="HARD" onTap="pickDifficulty">偏难 · 压力面</view>
    </view>
  </view>

  <button class="btn" onTap="createInterview" disabled="{{creating}}">
    {{creating ? phase : '生成面试题'}}
  </button>
  <view class="hint tiny muted">出题基于你的简历与 JD 语义匹配，通常 10-30 秒；不会额外扣减额度。</view>

  <view class="safe-bottom"></view>
</view>
