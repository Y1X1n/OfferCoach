<view class="container">
  <view class="head">
    <view class="head-title">准备这场面试</view>
    <view class="muted small">简历决定「问你什么」，岗位决定「标准是什么」。</view>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">简历</text>
      <text class="tiny link" onTap="pickResume">更换</text>
    </view>
    <view class="pick" a:if="{{currentResume}}">
      <view class="pick-title">{{currentResume.title}}</view>
      <view class="tiny muted">{{currentResume.summary}}</view>
    </view>
    <view class="tiny muted" a:else>还没有可用简历。</view>
    <button class="btn btn-ghost next" a:if="{{!currentResume}}" onTap="goResume">去添加简历</button>
  </view>

  <view class="card">
    <view class="row-between">
      <text class="card-title">目标岗位</text>
      <text class="tiny link" onTap="pickJd">更换</text>
    </view>
    <view class="pick" a:if="{{currentJd}}">
      <view class="pick-title">{{currentJd.title}}</view>
      <view class="tiny muted">{{currentJd.company || '未填写公司'}} · {{currentJd.skillsText}}</view>
    </view>
    <view class="tiny muted" a:else>还没有岗位 JD。</view>
    <button class="btn btn-ghost next" a:if="{{!currentJd}}" onTap="goJd">去添加岗位</button>
  </view>

  <view class="card">
    <view class="card-title">这场怎么练</view>
    <view class="opt-label">题量</view>
    <view class="seg">
      <view class="seg-item {{questionCount === 3 ? 'seg-on' : ''}}" data-count="3" onTap="pickCount">3 题 · 快速</view>
      <view class="seg-item {{questionCount === 5 ? 'seg-on' : ''}}" data-count="5" onTap="pickCount">5 题 · 标准</view>
      <view class="seg-item {{questionCount === 8 ? 'seg-on' : ''}}" data-count="8" onTap="pickCount">8 题 · 完整</view>
    </view>
    <view class="opt-label">难度</view>
    <view class="seg">
      <view class="seg-item {{difficulty === 'MIXED' ? 'seg-on' : ''}}" data-value="MIXED" onTap="pickDifficulty">循序渐进</view>
      <view class="seg-item {{difficulty === 'HARD' ? 'seg-on' : ''}}" data-value="HARD" onTap="pickDifficulty">偏难 · 压力面</view>
    </view>
    <view class="opt-label">面试官风格</view>
    <view class="seg">
      <view class="seg-item {{style === 'GENTLE' ? 'seg-on' : ''}}" data-value="GENTLE" onTap="pickStyle">温和</view>
      <view class="seg-item {{style === 'STANDARD' ? 'seg-on' : ''}}" data-value="STANDARD" onTap="pickStyle">标准</view>
      <view class="seg-item {{style === 'PRESSURE' ? 'seg-on' : ''}}" data-value="PRESSURE" onTap="pickStyle">压力</view>
    </view>
  </view>

  <button class="btn" onTap="createInterview" disabled="{{creating}}">
    {{creating ? phase : '生成面试题'}}
  </button>
  <view class="hint tiny muted">出题基于简历与 JD 语义匹配，通常 10-30 秒；创建时扣 1 次面试额度。</view>

  <view class="safe-bottom"></view>
</view>
