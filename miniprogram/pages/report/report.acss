.hero {
  background: #0f172a;
  border-radius: 24rpx;
  padding: 36rpx 32rpx;
  margin-bottom: 24rpx;
}

.hero-kicker {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #f0b49a;
}

.hero-title {
  margin-top: 12rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1.45;
}

.hero-sub {
  margin-top: 8rpx;
  color: #9aa3af;
}

.overall {
  margin-top: 28rpx;
  display: flex;
  align-items: baseline;
}

.overall-num {
  font-size: 88rpx;
  font-weight: 700;
  color: #ffffff;
  line-height: 1;
}

.overall-unit {
  margin-left: 8rpx;
  font-size: 24rpx;
  color: #9aa3af;
}

.overall-note {
  margin-top: 16rpx;
  color: #c7cdd6;
  line-height: 1.6;
}

.dim {
  margin-top: 20rpx;
}

.dim-head {
  margin-bottom: 8rpx;
}

.item {
  display: flex;
  margin-bottom: 10rpx;
}

.dot {
  margin-right: 10rpx;
  font-weight: 700;
}

.dot-ok {
  color: #2f7f5b;
}

.dot-warn {
  color: #b45309;
}

.item-text {
  flex: 1;
  font-size: 26rpx;
  line-height: 1.6;
  color: #1f2937;
}

.plan {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.plan:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.plan-head {
  display: flex;
  align-items: center;
  margin-bottom: 6rpx;
}

.plan-priority {
  font-size: 20rpx;
  font-weight: 700;
  color: #a34a2a;
  background: #fdf0ea;
  border-radius: 8rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.plan-action {
  font-size: 28rpx;
  font-weight: 600;
  flex: 1;
}

.qa {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
}

.qa:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.qa-head {
  margin-bottom: 8rpx;
}

.qa-question {
  font-size: 26rpx;
  font-weight: 600;
  line-height: 1.6;
}

.qa-answer {
  margin-top: 8rpx;
  padding: 12rpx 16rpx;
  background: #f7f8fa;
  border-radius: 12rpx;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 3;
  overflow: hidden;
}

.qa-summary {
  margin-top: 8rpx;
  color: #475569;
}

.back {
  margin-top: 20rpx;
}

.notice {
  margin-top: 32rpx;
  padding: 24rpx 28rpx;
  border-radius: 20rpx;
  background: #eef1f5;
}

.notice-title {
  font-size: 24rpx;
  font-weight: 600;
  color: #475569;
  margin-bottom: 8rpx;
}

.done {
  text-align: center;
  padding: 48rpx 32rpx;
}

.done-title {
  font-size: 34rpx;
  font-weight: 700;
  margin-bottom: 12rpx;
}

.next {
  margin-top: 32rpx;
}
