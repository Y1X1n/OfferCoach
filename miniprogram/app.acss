/* 设计语言与 Web 端一致：近黑主色 + 单一暖色强调 + 冷灰表面。 */

page {
  background: #f5f6f8;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx 32rpx 64rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  margin-bottom: 12rpx;
}

.muted {
  color: #6b7280;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stack-8 > view {
  margin-bottom: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f1f3f6;
  color: #475569;
  margin-right: 12rpx;
}

.tag-ember {
  background: #fdf0ea;
  color: #a34a2a;
}

.btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #0f172a;
  color: #ffffff;
  border: none;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #0f172a;
  border: 2rpx solid #d9dee6;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-mini {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  width: auto;
  display: inline-block;
}

.divider {
  height: 2rpx;
  background: #eef1f5;
  margin: 24rpx 0;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #a34a2a;
}

.field {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 2rpx solid #e5e9ef;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
}

.placeholder {
  color: #9aa3af;
}

.empty {
  text-align: center;
  color: #9aa3af;
  padding: 48rpx 0;
  font-size: 26rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
