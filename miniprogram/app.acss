/* 设计语言与 Web 端一致：近黑主色 + 单一暖色强调 + 冷灰表面。 */

page {
  background: #f5f6f8;
  color: #0f172a;
  font-family: -apple-system, BlinkMacSystemFont, 'PingFang SC', 'Helvetica Neue', Arial, sans-serif;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx 32rpx 64rpx;
}

.card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(15, 23, 42, 0.04);
}

.card-title {
  font-size: 30rpx;
  font-weight: 600;
  letter-spacing: 0.5rpx;
  margin-bottom: 12rpx;
}

.muted {
  color: #6b7280;
}

.small {
  font-size: 24rpx;
}

.tiny {
  font-size: 22rpx;
}

.strong {
  font-weight: 600;
}

.row {
  display: flex;
  align-items: center;
}

.row-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stack-8 > view {
  margin-bottom: 8rpx;
}

.tag {
  display: inline-block;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  background: #f1f3f6;
  color: #475569;
  margin-right: 12rpx;
}

.tag-ember {
  background: #fdf0ea;
  color: #a34a2a;
}

.btn {
  display: block;
  width: 100%;
  box-sizing: border-box;
  text-align: center;
  padding: 28rpx 0;
  border-radius: 20rpx;
  font-size: 30rpx;
  font-weight: 600;
  background: #0f172a;
  color: #ffffff;
  border: none;
  line-height: 1.2;
}

.btn::after {
  border: none;
}

.btn-ghost {
  background: #ffffff;
  color: #0f172a;
  border: 2rpx solid #d9dee6;
}

.btn[disabled] {
  opacity: 0.45;
}

.btn-mini {
  padding: 16rpx 28rpx;
  font-size: 26rpx;
  width: auto;
  display: inline-block;
}

.divider {
  height: 2rpx;
  background: #eef1f5;
  margin: 24rpx 0;
}

.bar {
  height: 12rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  overflow: hidden;
}

.bar-fill {
  height: 100%;
  border-radius: 999rpx;
  background: #a34a2a;
}

.field {
  width: 100%;
  box-sizing: border-box;
  background: #f7f8fa;
  border: 2rpx solid #e5e9ef;
  border-radius: 16rpx;
  padding: 20rpx 24rpx;
  font-size: 28rpx;
  line-height: 1.7;
  color: #0f172a;
}

.placeholder {
  color: #9aa3af;
}

.empty {
  text-align: center;
  color: #9aa3af;
  padding: 48rpx 0;
  font-size: 26rpx;
}

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}

/* 列表、标签页与操作区（多个页面共用） */
.section-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #475569;
  margin: 8rpx 8rpx 16rpx;
}

.list {
  background: #ffffff;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.list-item {
  display: flex;
  align-items: center;
  padding: 26rpx 32rpx;
  border-bottom: 2rpx solid #f1f3f6;
}

.list-item:last-child {
  border-bottom: none;
}

.list-main {
  flex: 1;
  min-width: 0;
}

.list-title {
  font-size: 28rpx;
  font-weight: 600;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.list-sub {
  font-size: 23rpx;
  color: #6b7280;
  margin-top: 4rpx;
}

.list-arrow {
  color: #c3c9d2;
  font-size: 34rpx;
  margin-left: 16rpx;
}

.badge {
  display: inline-block;
  flex-shrink: 0;
  white-space: nowrap;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 21rpx;
  background: #f1f3f6;
  color: #475569;
  margin-left: 10rpx;
}

.badge-ember {
  background: #fdf0ea;
  color: #a34a2a;
}

.badge-ok {
  background: #e9f5ef;
  color: #2f7f5b;
}

.badge-warn {
  background: #fff4e5;
  color: #b45309;
}

.tabs {
  display: flex;
  background: #ffffff;
  border-radius: 18rpx;
  padding: 6rpx;
  margin-bottom: 24rpx;
}

.tab {
  flex: 1;
  text-align: center;
  padding: 16rpx 0;
  font-size: 26rpx;
  color: #5b6472;
  border-radius: 14rpx;
}

.tab-on {
  background: #0f172a;
  color: #ffffff;
  font-weight: 600;
}

.btn-row {
  display: flex;
  gap: 16rpx;
  margin-top: 24rpx;
}

.btn-row .btn {
  flex: 1;
}

.grid-2 {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  margin-bottom: 24rpx;
}

.grid-2 .tile {
  width: calc(50% - 8rpx);
  background: #ffffff;
  border-radius: 20rpx;
  padding: 24rpx;
  box-sizing: border-box;
}

.tile-title {
  font-size: 27rpx;
  font-weight: 600;
}

.tile-sub {
  font-size: 22rpx;
  color: #6b7280;
  margin-top: 6rpx;
}

.kv {
  display: flex;
  justify-content: space-between;
  padding: 16rpx 0;
  border-bottom: 2rpx solid #f1f3f6;
  font-size: 26rpx;
}

.kv:last-child {
  border-bottom: none;
}

.kv-k {
  color: #6b7280;
}

.kv-v {
  font-weight: 600;
  max-width: 62%;
  text-align: right;
}

.spacer {
  height: 24rpx;
}

.link {
  color: #a34a2a;
  font-size: 24rpx;
}

/* 页面头部与内联编辑（简历 / JD / 我的共用） */
.head {
  padding: 8rpx 8rpx 24rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.detail-title {
  font-size: 32rpx;
  line-height: 1.5;
  flex: 1;
  min-width: 0;
  margin-right: 12rpx;
  word-break: break-all;
}

.paste {
  height: 240rpx;
  margin-top: 12rpx;
}

.next {
  margin-top: 24rpx;
}

/* 结构化内容 */
.section {
  margin-bottom: 22rpx;
}

.section-name {
  font-size: 24rpx;
  color: #a34a2a;
  font-weight: 600;
  margin-bottom: 6rpx;
}

.section-line {
  font-size: 26rpx;
  line-height: 1.7;
  white-space: pre-wrap;
}

.chip-row {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}

.chip-mini {
  font-size: 22rpx;
  color: #475569;
  background: #f1f3f6;
  border-radius: 999rpx;
  padding: 6rpx 16rpx;
  margin: 0 12rpx 12rpx 0;
}

.jd {
  height: 320rpx;
}

.preview-text {
  font-size: 24rpx;
  color: #475569;
  line-height: 1.7;
  margin: 12rpx 0;
  max-height: 320rpx;
  overflow: hidden;
}
